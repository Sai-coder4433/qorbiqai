rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================
    // HELPER FUNCTIONS FOR AUTHENTICATION & MULTI-TENANCY
    // =========================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Super Admin enforced via verified UID, email, custom claims or database role (Section 5)
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.uid == '6d6krJBCmDVgpwDhmhzDNI72pYa2' ||
        (request.auth.token != null && 'email' in request.auth.token && (request.auth.token.email == 'chakankarsai@gmail.com' || request.auth.token.email == 'chakankarsai@gmail.co')) ||
        ('role' in request.auth.token && request.auth.token.role == 'SUPER_ADMIN') ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'SUPER_ADMIN')
      );
    }

    // =========================================================
    // 0. SUPER ADMIN FULL MASTER ACCESS (Database Sync & Management)
    // =========================================================
    match /{document=**} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == '6d6krJBCmDVgpwDhmhzDNI72pYa2' ||
        request.auth.token.email == 'chakankarsai@gmail.com' ||
        request.auth.token.email == 'chakankarsai@gmail.co'
      );
    }

    // =========================================================
    // 1. USERS COLLECTION (Section 29)
    // =========================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      // Super Admin or client creating their own initial profile
      allow create: if isSuperAdmin() || (
        isAuthenticated() && request.auth.uid == userId && (
          !('role' in request.resource.data) || request.resource.data.role == 'BUSINESS_OWNER'
        )
      );
      // Clients cannot modify their own role, status, or subscription from client-side
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          request.auth.uid == userId && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'subscriptionId'])
        )
      );
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // 2. BUSINESSES COLLECTION (Strict Tenant Isolation)
    // =========================================================
    match /businesses/{businessId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || 
        resource.data.ownerId == request.auth.uid || 
        isSuperAdmin()
      );
      allow create: if isSuperAdmin() || (
        isAuthenticated() && (
          request.resource.data.ownerUid == request.auth.uid || 
          request.resource.data.ownerId == request.auth.uid
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          (resource.data.ownerUid == request.auth.uid || resource.data.ownerId == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'ownerUid', 'ownerId'])
        )
      );
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // 3. QR CODES COLLECTION
    // =========================================================
    match /qr_codes/{qrCodeId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || isSuperAdmin()
      );
      allow create: if isSuperAdmin() || (
        isAuthenticated() && request.resource.data.ownerUid == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || isSuperAdmin()
      );
    }

    // =========================================================
    // 4. PUBLIC QR LOOKUP CONFIGURATIONS & TOPICS
    // Read-only for customers; safe fields only.
    // =========================================================
    match /public_qr_configs/{uniqueCode} {
      allow read: if true;
      allow write: if false; // Cloud Functions / Server backend only
    }

    match /experience_topics/{topicId} {
      allow read: if true; // Public for customer review assistance
      allow write: if false; // Server backend verification only
    }

    // =========================================================
    // 5. QR SCAN EVENTS & SESSIONS
    // Client-side writes forbidden to prevent telemetry tampering
    // =========================================================
    match /qr_events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if false; // Recorded strictly via backend API
    }

    match /review_assistance_events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if false; // Recorded strictly via backend API
    }

    match /review_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /review_generations/{generationId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // =========================================================
    // 6. PAYMENTS & SUBSCRIPTIONS (Strict Server Authority)
    // =========================================================
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow write: if false; // Created and verified strictly by server
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isSuperAdmin()
      );
      allow write: if isSuperAdmin(); // Verified payments updated strictly via Cloud Functions / Server
    }

    match /credit_accounts/{creditAccountId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
      allow write: if false; // Incremented/decremented strictly by server AI endpoint
    }

    match /plans/{planId} {
      allow read: if true; // Public pricing catalog
      allow write: if isSuperAdmin();
    }

    match /usage_counters/{ownerUid} {
      allow read: if isAuthenticated() && (request.auth.uid == ownerUid || isSuperAdmin());
      allow write: if false; // Incremented strictly by server AI endpoint
    }

    match /daily_metrics/{metricId} {
      allow read: if isAuthenticated();
      allow write: if false; // Aggregated strictly by scheduled backend functions
    }

    // =========================================================
    // 7. ADMINISTRATIVE AUDIT LOGS (Section 34)
    // Immutable. Strictly Super Admin access.
    // =========================================================
    match /admin_audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // =========================================================
    // 8. SYSTEM SETTINGS
    // =========================================================
    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // =========================================================
    // 9. LEADS & ENQUIRIES (Public submission, Admin read/write)
    // =========================================================
    match /crm_leads/{leadId} {
      allow read: if isSuperAdmin();
      allow create: if true; // Public website enquiry forms can submit leads
      allow update, delete: if isSuperAdmin();
    }

    match /leads/{leadId} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================
    // 10. EMPLOYEES & STAFF ACCESS
    // =========================================================
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}
