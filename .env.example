# ========================================================
# QORBIQ AI / REVIEWFLOW - SaaS Environment Variables
# ========================================================

# Application Base Host URL (Used for redirects and webhooks)
APP_BASE_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
PORT="3000"
NODE_ENV="development"

# --------------------------------------------------------
# 1. Payment Gateway Selection
# Choose active gateway: 'CASHFREE' or 'RAZORPAY'
# --------------------------------------------------------
PAYMENT_GATEWAY="CASHFREE"

# --------------------------------------------------------
# 2. Cashfree Payment Gateway & Subscriptions
# Portal: https://merchant.cashfree.com/
# DevStudio: https://www.cashfree.com/devstudio
# Subscriptions: https://www.cashfree.com/devstudio/subs
# Webhook URL: ${APP_BASE_URL}/api/webhooks/cashfree
# --------------------------------------------------------
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_ENV="sandbox" # 'sandbox' for test mode or 'production' for live
CASHFREE_API_VERSION="2023-08-01"

# --------------------------------------------------------
# 3. Razorpay Payment Gateway (Optional alternative)
# Setup in Razorpay Dashboard -> Settings -> API Keys (Test Mode)
# Webhook URL: ${APP_BASE_URL}/api/webhooks/razorpay
# --------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# --------------------------------------------------------
# 4. Cloudflare Pages Deployment & Reverse Proxy
# For Cloudflare Pages Functions environment bindings:
# --------------------------------------------------------
BACKEND_SERVICE_URL="https://your-backend-api.onrender.com"

# --------------------------------------------------------
# 5. Firebase Client SDK (Vite Frontend)
# Set in GCP/Firebase Console -> Project Settings -> General -> Your Apps
# --------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="localos-ai-prod-saas.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="localos-ai-prod-saas"
VITE_FIREBASE_STORAGE_BUCKET="localos-ai-prod-saas.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="625748049908"
VITE_FIREBASE_APP_ID="1:625748049908:web:bd232258d7cd85150803a1"
VITE_FIREBASE_RECAPTCHA_KEY=""

# --------------------------------------------------------
# 6. Firebase Admin SDK (Server-Side)
# Generate private key in Firebase Console -> Project Settings -> Service accounts
# --------------------------------------------------------
FIREBASE_PROJECT_ID="localos-ai-prod-saas"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --------------------------------------------------------
# 7. Google Gemini AI (Strictly Server-Side)
# Get key from Google AI Studio (https://aistudio.google.com/)
# --------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# --------------------------------------------------------
# 8. Google Cloud OAuth 2.0 Credentials (Server-Side Flow)
# Authorized Redirect URI must match: ${APP_BASE_URL}/api/google/callback
# --------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# --------------------------------------------------------
# 9. Google Business Profile & Places API
# --------------------------------------------------------
GOOGLE_MAPS_API_KEY=""
GOOGLE_GBP_FEATURE_FLAG="PENDING_APPROVAL"

# --------------------------------------------------------
# 10. Encryption Key (32-byte hex for AES-256-GCM token storage)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# --------------------------------------------------------
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# --------------------------------------------------------
# 11. Communications & Notifications (Optional)
# --------------------------------------------------------
EMAIL_PROVIDER_KEY=""
WHATSAPP_PROVIDER_KEY=""
