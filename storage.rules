rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'SUPER_ADMIN';
    }

    // Public business media (logos, cover photos, website assets)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024;
    }

    // Business logos uploaded from onboarding & business settings
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024;
    }

    match /business_logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024;
    }

    // Tenant-isolated private assets
    match /organizations/{orgId}/{allPaths=**} {
      allow read: if isAuthenticated() && (request.auth.token.organizationId == orgId || isSuperAdmin());
      allow write: if isAuthenticated() && (request.auth.token.organizationId == orgId || isSuperAdmin())
                   && request.resource.size < 25 * 1024 * 1024; // 25MB max
    }
  }
}
